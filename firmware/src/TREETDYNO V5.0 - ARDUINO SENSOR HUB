// ==========================================
// STREETDYNO V5.0 - ARDUINO SENSOR HUB
// "The GSF-Style EMV-Blocker"
// ==========================================

const int RPM_PIN = 2; // Interrupt Pin (D2 auf Nano/Uno)

// --- DER TÜRSTEHER (Lockout-Zeit) ---
// 3000 Mikrosekunden entsprechen max. 20.000 U/min. 
// Alles was schneller "funkt", MUSS Störrauschen sein und wird ignoriert.
const unsigned long DEBOUNCE_MICROS = 3000; 

volatile unsigned long lastSparkTime = 0;
volatile unsigned long sparkInterval = 0;
volatile bool newSpark = false;

float currentRPM = 0.0;

// --- INTERRUPT SERVICE ROUTINE (Hardware-Ebene) ---
void sparkISR() {
  unsigned long now = micros();
  unsigned long delta = now - lastSparkTime;
  
  // Die magische GSF-Wand: Nur durchlassen, wenn genug Zeit vergangen ist
  if (delta > DEBOUNCE_MICROS) {
    sparkInterval = delta;
    lastSparkTime = now;
    newSpark = true;
  }
}

void setup() {
  Serial.begin(115200);
  
  // Interner Pull-Up gegen Grundrauschen
  pinMode(RPM_PIN, INPUT_PULLUP);
  
  // Interrupt an Pin 2 anhängen. FALLING reagiert auf die negative Flanke.
  attachInterrupt(digitalPinToInterrupt(RPM_PIN), sparkISR, FALLING);
}

void loop() {
  unsigned long currentInterval = 0;
  unsigned long timeSinceLast = 0;
  bool calcNew = false;

  // 1. Daten sicher aus dem Interrupt kopieren (kurz anhalten)
  noInterrupts();
  currentInterval = sparkInterval;
  timeSinceLast = micros() - lastSparkTime;
  if (newSpark) {
    calcNew = true;
    newSpark = false;
  }
  interrupts();

  // 2. Drehzahl berechnen
  if (timeSinceLast > 500000) { 
    // Timeout: Kein Funke für 0,5 Sekunden -> Motor aus oder Standgas abgewürgt
    currentRPM = 0.0;
  } 
  else if (calcNew && currentInterval > 0) {
    // 60 Millionen Mikrosekunden geteilt durch Zeit zwischen zwei Funken = U/min
    currentRPM = 60000000.0 / currentInterval;
  }

  // ==========================================
  // HIER DEINE AFR / EGT SENSORIK EINBAUEN
  // ==========================================
  float afr = readAFR(); 
  float egt = readEGT(); 

  // 3. Ausgabe im perfekten Format für den Pi ($RPM;AFR;EGT)
  Serial.print("$");
  Serial.print(currentRPM, 1);
  Serial.print(";");
  Serial.print(afr, 2);
  Serial.print(";");
  Serial.println(egt, 1);

  // 10Hz Ausgabe-Rate
  delay(100); 
}

